{
  "author": "Deskpro",
  "name": "@deskpro/react-datepicker-hijri",
  "description": "A simple and reusable datepicker component for React",
  "version": "1.5.0",
  "license": "MIT",
  "homepage": "https://github.com/deskpro/react-datepicker-hijri",
  "main": "lib",
  "module": "es",
  "unpkg": "dist/react-datepicker.min.js",
  "style": "dist/react-datepicker.min.css",
  "files": [
    "*.md",
    "dist",
    "lib",
    "es",
    "src/stylesheets"
  ],
  "keywords": [
    "react",
    "datepicker",
    "calendar",
    "date",
    "react-component"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/deskpro/react-datepicker-hijri.git"
  },
  "bugs": {
    "url": "https://github.com/deskpro/react-datepicker-hijri/issues"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/eslint-parser": "^7.22.0",
    "@babel/plugin-external-helpers": "^7.22.0",
    "@babel/plugin-transform-class-properties": "^7.22.0",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-flow": "^7.27.1",
    "@babel/preset-react": "^7.22.0",
    "@rollup/plugin-babel": "^6.0.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.1.0",
    "@rollup/plugin-terser": "^0.4.0",
    "babel-loader": "^9.1.0",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "chai": "^3.5.0",
    "codecov.io": "^0.1.6",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.0",
    "enzyme": "^3.1.1",
    "enzyme-adapter-react-16": "^1.0.4",
    "eslint": "^8.43.0",
    "eslint-plugin-import": "^2.27.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.0",
    "eslint-plugin-react": "^7.32.0",
    "express": "^4.16.2",
    "flow-bin": "^0.68.0",
    "highlight.js": "^9.12.0",
    "husky": "^8.0.3",
    "isparta-loader": "^2.0.0",
    "karma": "^6.4.0",
    "karma-chai": "^0.1.0",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.0",
    "karma-mocha": "^2.0.1",
    "karma-sinon": "^1.0.5",
    "karma-sourcemap-loader": "^0.4.0",
    "karma-webpack": "^5.0.0",
    "lint-staged": "^13.2.0",
    "lodash": "^4.17.4",
    "mini-css-extract-plugin": "^2.7.0",
    "mocha": "^10.2.0",
    "moment": "^2.30.0",
    "moment-hijri": "^2.1.2",
    "npm-run-all": "^4.1.2",
    "prettier": "^2.8.0",
    "react": "^16.1.0",
    "react-docgen": "^2.20.0",
    "react-dom": "^16.1.0",
    "react-test-renderer": "^16.1.0",
    "react-transform-hmr": "^1.0.4",
    "rimraf": "^5.0.0",
    "rollup": "^3.26.0",
    "sass": "^1.77.0",
    "sass-lint": "^1.12.1",
    "sass-loader": "^13.3.0",
    "sinon": "^4.1.2",
    "style-loader": "^3.3.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-middleware": "^6.1.0",
    "webpack-dev-server": "^4.15.0",
    "webpack-hot-middleware": "^2.25.0"
  },
  "peerDependencies": {
    "moment": "^2.20.0",
    "moment-hijri": "^2.0.0",
    "react": "^16.0.0 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.0.0 || ^17.0.0 || ^18.0.0"
  },
  "dependencies": {
    "classnames": "^2.5.0",
    "prop-types": "^15.8.0",
    "react-onclickoutside": "^6.13.0",
    "react-popper": "^2.3.0"
  },
  "scripts": {
    "eslint": "eslint {src,test,docs-site/src}/**/*.{js,jsx} *.js",
    "flow": "flow",
    "precommit": "lint-staged",
    "sass-lint": "sass-lint --config .sass-lint.yml 'src/stylesheets/*.scss, docs-site/src/*.scss' -i 'docs-site/src/higlight.scss, docs-site/src/reset.scss'",
    "lint": "run-p eslint flow sass-lint",
    "start": "cross-env MODULES=false node server.js",
    "test": "cross-env NODE_ENV=test karma start karma.conf.js --single-run",
    "prepublish": "test $(npm -v | tr . '\\n' | head -n 1) -ge '4' || exit 1",
    "prepare": "npm run build",
    "codecov": "cat coverage/*/lcov.info | ./node_modules/codecov.io/bin/codecov.io.js",
    "prebuild": "rimraf es lib dist",
    "build": "cross-env NODE_ENV=production run-p build:** && run-p css:**",
    "build-dev": "cross-env NODE_ENV=development run-p build:** && run-p css:**",
    "css:prod": "sass --style=compressed src/stylesheets/datepicker.scss > dist/react-datepicker.min.css",
    "css:modules:prod": "sass --style=compressed src/stylesheets/datepicker-cssmodules.scss > dist/react-datepicker-cssmodules.min.css",
    "css:dev": "sass --style=expanded src/stylesheets/datepicker.scss > dist/react-datepicker.css",
    "css:modules:dev": "sass --style=expanded src/stylesheets/datepicker-cssmodules.scss > dist/react-datepicker-cssmodules.css",
    "build:es": "cross-env BABEL_ENV=es rollup -c -i src/index.jsx -o es/index.js",
    "build:cjs": "cross-env BABEL_ENV=cjs rollup -c -i src/index.jsx -o lib/index.js",
    "build:umd:dev": "cross-env BABEL_ENV=es rollup -c rollup.umd.config.js -i src/index.jsx -o dist/react-datepicker.js",
    "build:umd:prod": "cross-env BABEL_ENV=es rollup -c rollup.umd.config.js -i src/index.jsx -o dist/react-datepicker.min.js",
    "build:docs": "cross-env MODULES=false webpack --config webpack.docs.config.js"
  },
  "lint-staged": {
    "*.{js,jsx,json,css,scss,md}": [
      "prettier --write",
      "git add"
    ]
  }
}
